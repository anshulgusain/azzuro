{
  "name": "azzurro-review-insights",
  "version": "1.0.0",
  "private": true,
  "description": "Collects public Booking.com guest reviews for four Azzurro Hotels properties and turns them into an operations dashboard.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "playwright install chromium && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "collect": "tsx src/collector/cli.ts",
    "reclassify": "tsx scripts/reclassify.ts",
    "export-sample": "tsx scripts/export-sample.ts",
    "dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "sentiment": "^5.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/sentiment": "^5.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
