# Copy this file to .env and fill it in. .env is never committed.

# OpenAI key for the chat assistant. Leave empty to switch the assistant off.
OPENAI_API_KEY=

# Optional. Which OpenAI model answers questions (default gpt-5.6-terra).
# gpt-5.6-luna is cheaper; any model that supports function calling on the Responses API works.
OPENAI_MODEL=gpt-5.6-terra

# Optional. Only for an OpenAI-compatible endpoint such as a company proxy.
# OPENAI_BASE_URL=

# Optional. Fetch the latest reviews automatically every N hours (e.g. 24). Off when empty.
# AUTO_COLLECT_HOURS=24

# Optional. Where the database file lives (default data/azzurro.db).
# REVIEWS_DB=/var/data/azzurro.db

# Optional. Port for the dashboard (default 8787).
# PORT=8787
